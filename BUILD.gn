import("//build/package.gni")

config("zlib_config") {
  include_dirs = [ "." ]
}

config("zlib_warnings") {
  visibility = [ ":*" ]

  cflags = [ "-Wno-implicit-function-declaration" ]
}

if (is_fuchsia) {
  shared_library("zlib") {
    output_name = "z"
    deps = [
      ":zlib_static",
    ]

    public_configs = [ ":zlib_config" ]
  }
} else {
  group("zlib") {
    deps = [
      ":zlib_static",
    ]

    public_configs = [ ":zlib_config" ]
  }
}

source_set("zlib_static") {
  sources = [
    "adler32.c",
    "compress.c",
    "crc32.c",
    "crc32.h",
    "deflate.c",
    "deflate.h",
    "gzclose.c",
    "gzguts.h",
    "gzlib.c",
    "gzread.c",
    "gzwrite.c",
    "infback.c",
    "inffast.c",
    "inffast.h",
    "inffixed.h",
    "inflate.c",
    "inflate.h",
    "inftrees.c",
    "inftrees.h",
    "trees.c",
    "trees.h",
    "uncompr.c",
    "zconf.h",
    "zlib.h",
    "zutil.c",
    "zutil.h",
  ]

  configs += [ ":zlib_warnings" ]
  configs -= [ "//build/config:symbol_visibility_hidden" ]
  public_configs = [ ":zlib_config" ]
}

config("minizip_warnings") {
  visibility = [ ":*" ]

  cflags = [ "-Wno-implicit-function-declaration" ]

  if (is_clang) {
    # minizip uses `if ((a == b))` for some reason.
    cflags += [ "-Wno-parentheses-equality" ]
  }
}

target(default_library_type, "minizip") {
  sources = [
    "contrib/minizip/crypt.h",
    "contrib/minizip/ioapi.c",
    "contrib/minizip/ioapi.h",
    "contrib/minizip/unzip.c",
    "contrib/minizip/unzip.h",
    "contrib/minizip/zip.c",
    "contrib/minizip/zip.h",
  ]

  deps = [
    ":zlib",
  ]
  configs += [ ":minizip_warnings" ]
  configs -= [ "//build/config:symbol_visibility_hidden" ]
  public_configs = [ ":zlib_config" ]
}

package("package") {
  package_name = "zlib"
  system_image = true

  deps = [
    ":zlib",
  ]

  libraries = [ {
        name = "libz.so"
      } ]
}

#################################################
## SDK
#################################################

import("//build/nebula/nbl_sdk_library.gni")

nbl_sdk_library("zlib_sdk") {
  name = "zlib"
  category = "hee"
  hdr_dir = "."
  libs = [
    "libz.so",
  ]
  deps = [
    ":zlib",
  ]
}
